# Production Environment Variables for Anand Saathi

# Application
VITE_APP_NAME=Anand Saathi
VITE_APP_ENV=production
VITE_APP_URL=https://anandsaathi.com

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# External Services
VITE_IOT_API_URL=https://api.iot.anandsaathi.com
VITE_IOT_WS_URL=wss://ws.iot.anandsaathi.com
VITE_TIMESFM_API_URL=https://api.timesfm.anandsaathi.com
VITE_SATELLITE_API_URL=https://api.satellite.anandsaathi.com
VITE_GOVERNMENT_API_URL=https://api.government.anandsaathi.com

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics
VITE_ANALYTICS_ID=your_analytics_id

# Feature Flags
VITE_ENABLE_IOT=true
VITE_ENABLE_AI_FORECASTING=true
VITE_ENABLE_SATELLITE=true
VITE_ENABLE_GOVERNMENT=true

# Performance
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_INTERVAL=5000
