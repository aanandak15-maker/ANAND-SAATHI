# Environment Variables for Anand Saathi - PRODUCTION
# Copy this file to .env for production deployment

# Google Maps API Keys - Separate for development and production
# Get your production API key from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY_PRODUCTION=YOUR_ACTUAL_PRODUCTION_API_KEY_HERE

# Use production key in production environment
VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY_PRODUCTION}

# Supabase Configuration (Production)
VITE_SUPABASE_URL=https://your-production-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_production_project_id

# Application Configuration
VITE_APP_NAME=Anand Saathi
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# Production-specific settings
VITE_API_BASE_URL=https://your-production-api-url.com
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
